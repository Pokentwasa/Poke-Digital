{
  "redirects": [
    { "source": "/web-design-cape-town", "destination": "/services/web-design/", "permanent": true },
    { "source": "/web-design-cape-town/", "destination": "/services/web-design/", "permanent": true },
    { "source": "/service/:slug*", "destination": "/services/:slug*", "permanent": true },
    { "source": "/work/smshd.html", "destination": "/work/smshd", "permanent": true },
    { "source": "/work/lumina.html", "destination": "/work/lumina", "permanent": true },
    { "source": "/work/valt.html", "destination": "/work/valt", "permanent": true },
    { "source": "/work/wildehoek.html", "destination": "/work/wildehoek", "permanent": true },
    { "source": "/work/smshd/", "destination": "/work/smshd", "permanent": true },
    { "source": "/work/lumina/", "destination": "/work/lumina", "permanent": true },
    { "source": "/work/valt/", "destination": "/work/valt", "permanent": true },
    { "source": "/work/wildehoek/", "destination": "/work/wildehoek", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/work.html", "destination": "/work", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/work/", "destination": "/work", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy", "permanent": true },
    { "source": "/terms/", "destination": "/terms", "permanent": true }
  ],
  "rewrites": [
    { "source": "/work/smshd", "destination": "/work/smshd/index.html" },
    { "source": "/work/lumina", "destination": "/work/lumina/index.html" },
    { "source": "/work/valt", "destination": "/work/valt/index.html" },
    { "source": "/work/wildehoek", "destination": "/work/wildehoek/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/work", "destination": "/work/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.web3forms.com https://www.google-analytics.com https://analytics.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
